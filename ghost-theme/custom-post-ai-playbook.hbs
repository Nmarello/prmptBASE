{{!< default}}

{{#post}}
<div class="post-header-wrap">
  <div class="post-header">
    <span class="post-tag">AI Playbook</span>
    <h1 class="post-title">{{title}}</h1>
    {{#if custom_excerpt}}<p class="post-excerpt">{{custom_excerpt}}</p>{{/if}}
    <div class="post-meta">
      <span>{{@site.title}}</span>
      <span>&middot;</span>
      <span>{{date published_at format="MMMM D, YYYY"}}</span>
      <span>&middot;</span>
      <span>{{reading_time}}</span>
    </div>
  </div>
</div>

<div class="post-content-wrap">
  <div class="post-content">
    {{#if feature_image}}
    <img src="{{feature_image}}" alt="{{title}}" class="post-content-feature">
    {{/if}}
    {{{content}}}
  </div>
</div>
{{/post}}
